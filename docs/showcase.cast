[27.4402, "o", "8;2;38;48;68m                                                                                            \u001b[20;5HHow do I scroll a list?                                                                        \u001b[21;5H   \u001b[22;5H\u001b[0m\u001b[1;32mbot\u001b[0m                                                                                            \u001b[23;5HA ScrollBox takes whatever height the layout leaves it, stays pinned to the newest line while  \u001b[24;5Han answer\u001b[24;15Hstreams\u001b[24;23Hin,\u001b[24;27Hand\u001b[24;31Hholds\u001b[24;37Hstill\u001b[24;43Honce\u001b[24;48Hyou\u001b[24;52Hscroll\u001b[24;59Hup\u001b[24;62Hto\u001b[24;65Hread.\u001b[24;71HThe\u001b[24;75Hfield\u001b[24;81Hbelow\u001b[24;87His\u001b[24;90Ha\u001b[25;5HTextArea: it wraps, grows to a few rows, and\u001b[25;50Hk\u001b[25;52Heps the line breaks of what\u001b[25;80Hver you\u001b[25;88Hpaste.    \u001b[26;5H  \u001b[26;8H      \u001b[26;15H       \u001b[26;23H   \u001b[26;27H   \u001b[26;31H     \u001b[26;37H     \u001b[26;43H    \u001b[26;48H   \u001b[26;52H      \u001b[26;59H  \u001b[26;62H  \u001b[26;65H     \u001b[26;71H   \u001b[26;75H     \u001b[26;81H     \u001b[26;87H  \u001b[26;90H \u001b[27;5H\u001b[0m\u001b[1;34;48;2;211;211;211m› \u001b[0m\u001b"]
