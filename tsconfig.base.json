{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "ES2022.Intl"],
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    // No `baseUrl` (removed in TS 7): `paths` entries resolve relative to this
    // file's directory.
    "types": ["node", "vitest/globals"],
    // Resolve @flowtty/* to package source so `tsc --noEmit` works without a
    // prior build. tsdown builds publish to dist/ and the package.json `exports`
    // field points there for installed consumers.
    "paths": {
      "@flowtty/core":          ["./packages/core/src/index.ts"],
      "@flowtty/core/host":     ["./packages/core/src/host/index.ts"],
      "@flowtty/core/testing":  ["./packages/core/src/testing/index.ts"],
      "@flowtty/react":         ["./packages/react/src/index.ts"],
      "@flowtty/tty-backend":   ["./packages/tty-backend/src/index.ts"],
      "@flowtty/inline-tty-backend": ["./packages/inline-tty-backend/src/index.ts"]
    }
  }
}
