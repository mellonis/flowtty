{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"],
    "paths": {
      "@flowtty/core":               ["../../packages/core/src/index.ts"],
      "@flowtty/core/host":          ["../../packages/core/src/host/index.ts"],
      "@flowtty/core/testing":       ["../../packages/core/src/testing/index.ts"],
      "@flowtty/react":              ["../../packages/react/src/index.ts"],
      "@flowtty/tty-backend":        ["../../packages/tty-backend/src/index.ts"],
      "@flowtty/inline-tty-backend": ["../../packages/inline-tty-backend/src/index.ts"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx"]
}
