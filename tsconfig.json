{
  // Root tsconfig drives `tsc --noEmit` across the whole workspace. Each
  // package also has its own tsconfig (extending tsconfig.base.json) for IDE
  // multi-project support and per-package builds via tsdown (whose dts step also reads THIS file — see any tsdown.config.ts).
  "extends": "./tsconfig.base.json",
  "include": [
    "packages/*/src",
    "packages/examples/**/*.{ts,tsx}"
  ]
}
